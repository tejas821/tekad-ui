# Keep pnpm's isolation intact. Hoisting would reintroduce exactly the phantom
# dependencies pnpm was chosen to prevent (ADR-012).
node-linker=isolated
hoist=false
shamefully-hoist=false

# A library monorepo must fail loudly on an unmet peer, not warn.
strict-peer-dependencies=true

# Reproducibility: CI installs from the committed lockfile or fails.
prefer-frozen-lockfile=true
resolution-mode=highest
