{
  "name": "core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/core/src",
  "prefix": "tk",
  "projectType": "library",
  "tags": ["layer:foundation"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/packages/core"],
      "options": {
        "project": "packages/core/ng-package.json",
        "tsConfig": "packages/core/tsconfig.lib.json"
      },
      "configurations": {
        "production": {},
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "buildTarget": "core:build",
        "tsConfig": "packages/core/tsconfig.spec.json",
        "runner": "vitest",
        "include": [
          "**/*.spec.ts",
          "../a11y/**/*.spec.ts",
          "../forms/**/*.spec.ts",
          "../primitives/**/*.spec.ts"
        ]
      }
    }
  }
}
