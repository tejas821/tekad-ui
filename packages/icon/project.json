{
  "name": "icon",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/icon/src",
  "prefix": "tk",
  "projectType": "library",
  "tags": ["layer:component"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/packages/icon"],
      "options": {
        "project": "packages/icon/ng-package.json",
        "tsConfig": "packages/icon/tsconfig.lib.json"
      },
      "configurations": {
        "production": {},
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "buildTarget": "icon:build",
        "tsConfig": "packages/icon/tsconfig.spec.json",
        "runner": "vitest",
        "include": ["**/*.spec.ts"]
      }
    }
  }
}
