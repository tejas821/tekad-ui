{
  "$schema": "https://tr.designtokens.org/format/2025.10/",
  "$description": "TEKAD semantic design tokens. Metadata for design tooling — NEVER a runtime dependency (ADR-007 decision 9). The shipped artefact is styles/tekad.css.",
  "color": {
    "surface": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "The default page background.",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#ffffff",
          "dark": "#030304"
        }
      }
    },
    "on-surface": {
      "$type": "color",
      "$value": "#030304",
      "$description": "Body text on the default background.",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#030304",
          "dark": "#eeeeef"
        }
      }
    },
    "surface-variant": {
      "$type": "color",
      "$value": "#eeeeef",
      "$description": "A recessed or grouped background: table headers, wells, disabled fields.",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#eeeeef",
          "dark": "#151617"
        }
      }
    },
    "on-surface-variant": {
      "$type": "color",
      "$value": "#2d2e30",
      "$description": "Secondary text. Still body text, so still 4.5:1 — 'secondary' is not a licence to be unreadable.",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#2d2e30",
          "dark": "#bdbebf"
        }
      }
    },
    "primary": {
      "$type": "color",
      "$value": "#22428d",
      "$description": "The main action colour.",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#22428d",
          "dark": "#a0bef9"
        }
      }
    },
    "on-primary": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Text and icons on a filled primary surface.",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#ffffff",
          "dark": "#02103e"
        }
      }
    },
    "primary-container": {
      "$type": "color",
      "$value": "#cedeff",
      "$description": "A tinted primary background: selected rows, soft badges.",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#cedeff",
          "dark": "#0d2767"
        }
      }
    },
    "on-primary-container": {
      "$type": "color",
      "$value": "#02103e",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#02103e",
          "dark": "#cedeff"
        }
      }
    },
    "danger": {
      "$type": "color",
      "$value": "#831a18",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#831a18",
          "dark": "#f7a59c"
        }
      }
    },
    "on-danger": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#ffffff",
          "dark": "#320001"
        }
      }
    },
    "danger-container": {
      "$type": "color",
      "$value": "#ffd2cc",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#ffd2cc",
          "dark": "#5d0004"
        }
      }
    },
    "on-danger-container": {
      "$type": "color",
      "$value": "#320001",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#320001",
          "dark": "#ffd2cc"
        }
      }
    },
    "success": {
      "$type": "color",
      "$value": "#0a5722",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#0a5722",
          "dark": "#9ccca2"
        }
      }
    },
    "on-success": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#ffffff",
          "dark": "#001d06"
        }
      }
    },
    "success-container": {
      "$type": "color",
      "$value": "#c9e8cc",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#c9e8cc",
          "dark": "#003911"
        }
      }
    },
    "on-success-container": {
      "$type": "color",
      "$value": "#001d06",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#001d06",
          "dark": "#c9e8cc"
        }
      }
    },
    "warning": {
      "$type": "color",
      "$value": "#624000",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#624000",
          "dark": "#deb680"
        }
      }
    },
    "on-warning": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#ffffff",
          "dark": "#211300"
        }
      }
    },
    "warning-container": {
      "$type": "color",
      "$value": "#f4dab7",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#f4dab7",
          "dark": "#402800"
        }
      }
    },
    "on-warning-container": {
      "$type": "color",
      "$value": "#211300",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#211300",
          "dark": "#f4dab7"
        }
      }
    },
    "outline": {
      "$type": "color",
      "$value": "#626366",
      "$description": "A component boundary a user must be able to perceive: input borders, dividers that carry meaning. WCAG 1.4.11 non-text contrast, 3:1.",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#626366",
          "dark": "#7f8083"
        }
      }
    },
    "outline-variant": {
      "$type": "color",
      "$value": "#dddedf",
      "$description": "A decorative separator carrying no information. Deliberately has NO contrastWith: holding a purely cosmetic hairline to 3:1 would force it to look like a border.",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#dddedf",
          "dark": "#2d2e30"
        }
      }
    },
    "focus-ring": {
      "$type": "color",
      "$value": "#22428d",
      "$description": "The focus indicator. WCAG 2.4.11/2.4.13 — it must be perceivable against the background it sits on.",
      "$extensions": {
        "com.tekad.scheme": {
          "light": "#22428d",
          "dark": "#a0bef9"
        }
      }
    }
  },
  "space": {
    "0": {
      "$type": "dimension",
      "$value": "0"
    },
    "1": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "2": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "3": {
      "$type": "dimension",
      "$value": "0.75rem"
    },
    "4": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "5": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "6": {
      "$type": "dimension",
      "$value": "2rem"
    },
    "7": {
      "$type": "dimension",
      "$value": "3rem"
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0"
    },
    "sm": {
      "$type": "dimension",
      "$value": "0.25rem"
    },
    "md": {
      "$type": "dimension",
      "$value": "0.5rem"
    },
    "lg": {
      "$type": "dimension",
      "$value": "1rem"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  }
}
